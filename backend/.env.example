GEMINI_API_KEY=...
GEMINI_MODEL=gemini-3.5-flash
# Free tier, no credit card required - get a key at https://aistudio.google.com/apikey

# Leave unset/false for local dev (falls back to GEMINI_API_KEY above when a
# request has no X-Gemini-Api-Key of its own). Set to true ONLY on a
# publicly reachable deployment (e.g. Render) - otherwise anyone who finds
# the URL could drain this server's shared free-tier quota with no key of
# their own.
REQUIRE_CALLER_API_KEY=false

# Optional - no key needed to use Semantic Scholar's search API, it just
# raises the shared rate limit: https://www.semanticscholar.org/product/api
SEMANTIC_SCHOLAR_API_KEY=

DATABASE_URL=sqlite:///./blip.db

CANDIDATE_COUNT=8
TOP_N_RESULTS=10

FRONTEND_ORIGIN=http://localhost:5173
