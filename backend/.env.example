APP_NAME=BLIP API
APP_ENV=development
DEBUG=true

API_V1_PREFIX=/api/v1

# SQLite for local dev. For production, use:
# DATABASE_URL=postgresql+asyncpg://user:password@host:5432/blip
DATABASE_URL=sqlite+aiosqlite:///./blip.db

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173

LOG_LEVEL=INFO
# "text" for human-readable local logs; "json" for production log aggregators
LOG_FORMAT=text

# Optional: raises Semantic Scholar's shared-pool rate limit if set
SEMANTIC_SCHOLAR_API_KEY=

# Optional: contact email for OpenAlex's "polite pool" (higher rate limits)
OPENALEX_MAILTO=

EXTERNAL_API_TIMEOUT_SECONDS=10.0
SEARCH_CACHE_TTL_SECONDS=3600

# Required for POST /api/v1/analyze (AI paper analysis) and
# POST /api/v1/compare (AI comparison engine)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Minimum analyzed papers required before POST /api/v1/compare will run
COMPARISON_MIN_PAPERS=10

# Authentication placeholders (core/security.py) -- no login endpoint uses
# these yet. MUST be overridden with a long random value in any shared or
# production environment; the default is only safe for local dev.
SECRET_KEY=insecure-dev-secret-change-me
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
