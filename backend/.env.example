APP_NAME=BLIP API
APP_ENV=development
DEBUG=true

API_V1_PREFIX=/api/v1

# SQLite for local dev. For production, use:
# DATABASE_URL=postgresql+asyncpg://user:password@host:5432/blip
DATABASE_URL=sqlite+aiosqlite:///./blip.db

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173

LOG_LEVEL=INFO
