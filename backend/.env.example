APP_NAME=BLIP API
APP_ENV=development
DEBUG=true

API_V1_PREFIX=/api/v1

# SQLite for local dev. For production, use:
# DATABASE_URL=postgresql+asyncpg://user:password@host:5432/blip
DATABASE_URL=sqlite+aiosqlite:///./blip.db

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173

LOG_LEVEL=INFO

# Optional: raises Semantic Scholar's shared-pool rate limit if set
SEMANTIC_SCHOLAR_API_KEY=

# Optional: contact email for OpenAlex's "polite pool" (higher rate limits)
OPENALEX_MAILTO=

EXTERNAL_API_TIMEOUT_SECONDS=10.0
SEARCH_CACHE_TTL_SECONDS=3600
