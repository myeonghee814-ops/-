# Copy to .env (same directory as docker-compose.prod.yml) and fill in
# real values before running:
#   docker compose -f docker-compose.prod.yml up --build -d
#
# Unlike backend/.env.example and frontend/.env.example (consumed inside
# each container), these are read by Docker Compose itself to fill in the
# ${VAR} references in docker-compose.prod.yml.

# --- Postgres ---
POSTGRES_USER=blip
POSTGRES_PASSWORD=change-me-to-a-long-random-value
POSTGRES_DB=blip

# --- Backend ---
# Real frontend origin(s), comma-separated, e.g. https://blip.example.com
CORS_ORIGINS=https://your-domain.example.com
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me-to-a-long-random-value

# Optional -- AI features degrade gracefully (see docs/ARCHITECTURE.md) if unset
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
SEMANTIC_SCHOLAR_API_KEY=
OPENALEX_MAILTO=
